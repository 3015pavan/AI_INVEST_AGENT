# ============================================
# API CONFIGURATION
# ============================================
# Local development
VITE_API_BASE_URL=http://localhost:5000

# Production (update with your actual Render backend URL)
# VITE_API_BASE_URL=https://investagent-backend.onrender.com

# Legacy API URL (for backward compatibility)
VITE_API_URL=http://localhost:5000/api

# ============================================
# GOOGLE OAUTH
# ============================================
# Same Client ID as backend - See GOOGLE_OAUTH_SETUP.md
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ============================================
# ERROR TRACKING & MONITORING
# ============================================
# Sentry DSN - See SENTRY_SETUP.md
VITE_SENTRY_DSN=
# Leave empty for development, add in production
# Example: https://xxx@o123.ingest.sentry.io/789

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PLAID=true
VITE_ENABLE_AI_RECOMMENDATIONS=true

# ============================================
# PRODUCTION NOTES
# ============================================
# 1. All VITE_ variables are embedded in the build at build time
# 2. These are PUBLIC - do not put secrets here
# 3. Set these in Vercel project settings for production
# 4. Changes require rebuild to take effect
# 5. Never put API keys or secrets in frontend env vars
