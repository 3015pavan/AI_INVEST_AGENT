# Production Environment Variables Template
# Copy this to your Render dashboard

NODE_ENV=production
PORT=5000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/investagent?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=generate-a-random-64-character-string-here
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=979018169574-2jspfqkafrtronvsksnql7chhjhrdrv8.apps.googleusercontent.com

# Frontend URL (Update with your Vercel URL)
FRONTEND_URL=https://investagent.vercel.app

# Market Data Provider
MARKET_PROVIDER=yahoo
MARKET_MAX_RETRIES=3
MARKET_RETRY_DELAY=1000

# OpenAI (Optional - for AI features)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# Pinecone (Optional - for RAG features)
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_INDEX=investagent-vectors

# Sentry (Optional - for error tracking)
# SENTRY_DSN_BACKEND=your_sentry_backend_dsn

# Logging
LOG_LEVEL=info
