# Test Environment Variables
# Copy this to .env.test for local testing

# JWT Configuration
JWT_SECRET=test-jwt-secret-do-not-use-in-production
JWT_EXPIRE=7d

# Database (MongoDB Memory Server will override this in unit tests)
MONGODB_URI=mongodb://localhost:27017/investagent-test

# API Keys (mocked in tests, but needed for structure)
OPENAI_API_KEY=test-openai-key
PINECONE_API_KEY=test-pinecone-key
PINECONE_ENVIRONMENT=test-environment
PINECONE_INDEX_NAME=test-index

# Google OAuth (mocked in tests)
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

# Plaid (mocked in tests)
PLAID_CLIENT_ID=test-plaid-client-id
PLAID_SECRET=test-plaid-secret
PLAID_ENV=sandbox

# Market Data (mocked in tests)
ALPHA_VANTAGE_API_KEY=test-alpha-vantage-key
FINNHUB_API_KEY=test-finnhub-key

# Server Configuration
PORT=5000
NODE_ENV=test

# Frontend URL
FRONTEND_URL=http://localhost:3002

# Email (mocked in tests)
EMAIL_SERVICE=test
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test-password

# Note: All external services are mocked in tests
# These values are for reference only and won't be used
