# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE
# ============================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/investagent

# Production MongoDB Atlas (example)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/investagent?retryWrites=true&w=majority

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# ============================================
# AI & VECTOR STORE
# ============================================
# OpenAI API Key - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=30000

# Pinecone Vector Database - Get from: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=your_pinecone_index_name_here

# ============================================
# OAUTH & AUTHENTICATION
# ============================================
# Google OAuth - See GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================
# PLAID BANKING INTEGRATION
# ============================================
# Plaid API Keys - Get from: https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
# Options: sandbox (testing), development (testing with real data), production

# ============================================
# MARKET DATA APIs
# ============================================
# Market Provider Configuration
MARKET_PROVIDER=yahoo
MARKET_MAX_RETRIES=3
MARKET_RETRY_DELAY=1000
MARKET_BACKOFF_MULTIPLIER=2

# Alpha Vantage - Get from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Finnhub - Get from: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpaca API (optional alternative provider)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET=your_alpaca_secret_here
ALPACA_BASE_URL=https://data.alpaca.markets/v2

# ============================================
# EMAIL SERVICE
# ============================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# For Gmail, create App Password: https://myaccount.google.com/apppasswords

# ============================================
# CORS & FRONTEND
# ============================================
# Local development
FRONTEND_URL=http://localhost:3002

# Production (update with your actual Vercel URL)
# FRONTEND_URL=https://investagent.vercel.app

# ============================================
# ERROR TRACKING & MONITORING
# ============================================
# Sentry DSN - See SENTRY_SETUP.md
SENTRY_DSN_BACKEND=
# Leave empty for development, add in production

# Winston Logger Level
LOG_LEVEL=info
# Options: error, warn, info, http, debug
