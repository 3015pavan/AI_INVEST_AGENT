{
  "name": "investagent",
  "version": "1.0.0",
  "description": "InvestAgent - AI-Powered Investment Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:coverage": "npm run test:backend -- --coverage && npm run test:frontend -- --coverage",
    "test:ci": "npm run test:backend -- --ci --coverage --maxWorkers=2 && npm run test:frontend -- --ci --coverage --maxWorkers=2",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "install:playwright": "playwright install --with-deps"
  },
  "keywords": [
    "investment",
    "ai",
    "portfolio",
    "fintech"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "concurrently": "^8.2.2"
  }
}
